# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Render: configure DATABASE_URL com a URL pooled do Neon, incluindo
# ?sslmode=require&sslaccept=strict. No executor de migração, use a URL direta
# na mesma variável. Adicione sslcert com o caminho da CA privada quando necessário.
DATABASE_URL=postgresql://fluency_user:PASSWORD@localhost:5432/fluency_db

# Ative para exigir TLS também em desenvolvimento. Produção sempre exige TLS.
DB_SSL_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
# Render: configure o endpoint TCP autenticado do Upstash em REDIS_URL.
# REDIS_URL=rediss://USER:PASSWORD@redis.example.test:6379
# Se usar uma CA privada, configure NODE_EXTRA_CA_CERTS antes de iniciar Node.
# REDIS_HOST e REDIS_PORT servem ao Redis local quando REDIS_URL está ausente.
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRATION=7d

# HMAC para validação de role na edge do Next.js
# Em produção, use o mesmo segredo dedicado de pelo menos 32 bytes na API e no frontend.
# O fallback para JWT_SECRET é exclusivo de desenvolvimento/teste.
AUTH_ROLE_COOKIE_SECRET=your_super_secret_role_cookie_key_here

# ─────────────────────────────────────────────────────────────────────────────
# APP / HTTP
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Cota por minuto e por área da API. Autenticação usa sua própria cota.
RATE_LIMIT_MAX_REQUESTS=600
APP_PORT=3001
# No Render, deixe APP_PORT ausente para escutar na PORT fornecida pelo serviço.
# Em produção, defina a origem HTTPS exata da Vercel sem barra final.
FRONTEND_URL=http://localhost:3000
# TRUST_PROXY aceita os IPs/CIDRs dos proxies confiáveis separados por vírgula.
# TRUST_PROXY=
# Swagger fica desabilitado por padrão em produção.
# SWAGGER_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# GRAMMAR PIPELINE — tradutor OPUS-MT local, sem chave ou API
# ─────────────────────────────────────────────────────────────────────────────
# O padrão é backend/.venv e ~/.cache/fluency-os/opus/opus-2021-02-23-ct2-int8.
# GRAMMAR_TRANSLATION_PYTHON=C:\path\to\backend\.venv\Scripts\python.exe
# GRAMMAR_LOCAL_TRANSLATION_MODEL_DIR=C:\Users\meu-usuario\.cache\fluency-os\opus\opus-2021-02-23-ct2-int8
# GRAMMAR_LOCAL_TRANSLATION_THREADS=4
