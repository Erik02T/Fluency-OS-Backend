# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# Produção: NÃO use localhost. Use string completa com credenciais de segredo.
# Exemplo Neon/Supabase/AWS: postgresql://user:pass@host:5432/db
DATABASE_URL=postgresql://fluency_user:PASSWORD@localhost:5432/fluency_db

# Habilita SSL na conexão Prisma (produção / conexões externas).
# Quando true, injeta ?sslmode=require&pgbouncer=true automaticamente
# (a menos que DATABASE_URL já os defina explicitamente).
DB_SSL_ENABLED=false

# Timeouts de conexão (em milissegundos)
DB_CONNECTION_TIMEOUT=10000  # falha rápido se DB inalcançável
DB_POOL_TIMEOUT=5000         # máximo aguardando conexão livre do pool
DB_IDLE_TIMEOUT=600000       # fecha conexão ociosa após 10min

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRATION=7d

# HMAC para validação de role na edge do Next.js
# Se não definido, usa fallback para JWT_SECRET
AUTH_ROLE_COOKIE_SECRET=your_super_secret_role_cookie_key_here

# ─────────────────────────────────────────────────────────────────────────────
# APP / HTTP
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
# Origem permitida no CORS (frontend)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# GRAMMAR PIPELINE — tradutor OPUS-MT local, sem chave ou API
# ─────────────────────────────────────────────────────────────────────────────
# O padrão é backend/.venv e ~/.cache/fluency-os/opus/opus-2021-02-23-ct2-int8.
# GRAMMAR_TRANSLATION_PYTHON=C:\path\to\backend\.venv\Scripts\python.exe
# GRAMMAR_LOCAL_TRANSLATION_MODEL_DIR=C:\Users\meu-usuario\.cache\fluency-os\opus\opus-2021-02-23-ct2-int8
# GRAMMAR_LOCAL_TRANSLATION_THREADS=4
