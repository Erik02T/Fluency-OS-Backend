node_modules
# Keep environment variables out of version control
.env

/generated/prisma

# Ignore raw datasets (large JSON/XML dumps, download separately from official releases)
data/jmdict*.json
data/*.json
# Grammar pipeline: track directory structure; ignore ephemeral stage outputs
data/generated/**
!data/generated/.gitkeep
data/validated/**
!data/validated/.gitkeep
data/rejected/**
!data/rejected/.gitkeep
# Rebuildable local sentence index
data/processed/sentences/*.sqlite*
!data/processed/sentences/.gitkeep
# Keep normalized/*.json trackable (canonical dataset); ignore other clutter
data/normalized/**
!data/normalized/.gitkeep
!data/normalized/*.json
prisma/seed/vocabulary/raw/*.json
prisma/seed/vocabulary/raw/*.xml
prisma/seed/vocabulary/normalized/*.json

# Ignore log files and directories
logs/
*.log

# Ignore build output
dist/

# Ignore dependency directories
node_modules/
.venv/

# Ignore test coverage output
coverage/